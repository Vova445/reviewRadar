APP_BASE_URL=http://localhost:4000
SESSION_SECRET=
AUTH_PASSWORD_PEPPER=
OAUTH_TOKEN_ENCRYPTION_KEY_ID=default
# Legacy single-key fallback; prefer OAUTH_TOKEN_ENCRYPTION_KEYS for rotation.
OAUTH_TOKEN_ENCRYPTION_KEY=
# JSON map of key IDs to secrets, for example {"old":"...","current":"..."}
OAUTH_TOKEN_ENCRYPTION_KEYS=
# Separate high-entropy secret required by the one-time rotation endpoint.
OAUTH_TOKEN_ROTATION_SECRET=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/integrations/google/callback
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_SYNC_SECRET=
TRIPADVISOR_API_KEY=
TELEGRAM_BOT_TOKEN=
APP_BASE_URL=http://localhost:4000

# Optional public feature flags (default off; only enable after implementation)
# NEXT_PUBLIC_FEATURE_AI_ANALYSIS=false
# NEXT_PUBLIC_FEATURE_ANOMALY_DETECTION=false
# NEXT_PUBLIC_FEATURE_ACTION_RECOMMENDATIONS=false
# NEXT_PUBLIC_FEATURE_INSIGHTS=false
# NEXT_PUBLIC_FEATURE_ALERT_DELIVERY=false
# NEXT_PUBLIC_FEATURE_WEEKLY_REPORTS=false
# NEXT_PUBLIC_FEATURE_DATA_EXPORT=false

# Optional HMAC key used to hash source IPs in audit records
# AUDIT_IP_HASH_KEY=replace-with-a-random-secret
